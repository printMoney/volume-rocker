    "NSAudioCaptureUsageDescription": {
      "comment": "Shown by macOS when asking for the System Audio Recording permission",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Volume Rocker needs this to adjust the volume of each app individually. Audio is processed on your Mac only and is never recorded or sent anywhere."
          }
        }
      }
    },
